#!/usr/bin/env bash
# A fake adb for the tests. It answers from fixture files and never talks to a device.
#
# FAKE_ADB_STATE is a directory holding:
#   devices                      `adb devices` output (header line included)
#   devices.later, appear_after  after <appear_after> `devices` calls, serve devices.later instead
#   dev/<serial>/model           getprop ro.product.model
#   dev/<serial>/serialno        getprop ro.serialno
#   dev/<serial>/avd             `emu avd name`
#   dev/<serial>/power, activity dumpsys power, dumpsys activity activities
#   dev/<serial>/window.policy   dumpsys window policy
#   dev/<serial>/window.displays dumpsys window displays
#   dev/<serial>/window.lastanr  optional; the full `dumpsys window` prints lastanr, policy, displays
#   dev/<serial>/window.displays.launched  replaces window.displays when `am start` runs
#   dev/<serial>/wm.size, wm.density  `wm size` / `wm density` output; default Physical size 1080x1240, density 480
#   dev/<serial>/settings/<ns>.<key>   a setting's value; no file = null
#   dev/<serial>/wake.wakes      if present, `input keyevent KEYCODE_WAKEUP` sets mWakefulness=Awake
#   dev/<serial>/wake.unlocks    if present, `wm dismiss-keyguard` clears the keyguard fields
#   log                          every call, one per line
set -uo pipefail
state="${FAKE_ADB_STATE:?FAKE_ADB_STATE not set}"
echo "adb $*" >> "$state/log"

serial=""
case "${1:-}" in
  -s) serial="$2"; shift 2 ;;
  -d|-e) echo "fake adb: $1 is not allowed in these scripts" >&2; exit 99 ;;
esac

case "${1:-}" in
  devices)
    n=$(( $(cat "$state/devices_calls" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$state/devices_calls"
    if [ -f "$state/appear_after" ] && [ "$n" -gt "$(cat "$state/appear_after")" ]; then
      cat "$state/devices.later"
    else
      cat "$state/devices"
    fi
    exit 0 ;;
  kill-server|start-server) echo "fake adb: $1 is not allowed" >&2; exit 99 ;;
esac

[ -n "$serial" ] || { echo "fake adb: call without -s: $*" >&2; exit 98; }
dev="$state/dev/$serial"
[ -d "$dev" ] || { echo "error: device '$serial' not found" >&2; exit 1; }

case "$1" in
  emu)
    [ "$*" = "emu avd name" ] || { echo "fake adb: unknown emu command: $*" >&2; exit 97; }
    cat "$dev/avd"; printf 'OK\n'; exit 0 ;;
  exec-out)
    [ "$*" = "exec-out screencap -p" ] || { echo "fake adb: unknown exec-out: $*" >&2; exit 97; }
    printf 'FAKEPNG'; exit 0 ;;
  shell) shift ;;
  *) echo "fake adb: unknown command: $*" >&2; exit 97 ;;
esac

# adb shell joins its arguments into one command line that the device's shell parses again. This fake
# never evaluates that line on the host. An argument holding a shell metacharacter (; | & $ ` < > newline
# CR) is logged and refused with exit 96, so the tests can assert that injection never reaches `shell`.
# Anything else is split into words here: whitespace separates words, and backslash escapes and single or
# double quotes group them, which is all a quoted (printf %q) argument without metacharacters needs.
for a in "$@"; do
  case "$a" in
    *[\;\|\&\$\`\<\>]*|*$'\n'*|*$'\r'*)
      echo "fake adb: shell metacharacters: $(printf '%q' "$a")" >> "$state/log"
      echo "fake adb: shell metacharacters in: $(printf '%q' "$a")" >&2; exit 96 ;;
  esac
done
line="$*" words=() word="" inword=0 quote="" i=0
while [ "$i" -lt "${#line}" ]; do
  c="${line:i:1}"; i=$((i + 1))
  if [ -n "$quote" ]; then
    if [ "$c" = "$quote" ]; then quote=""; else word+="$c"; fi
    continue
  fi
  case "$c" in
    ' '|$'\t') if [ "$inword" -eq 1 ]; then words+=("$word"); word="" inword=0; fi ;;
    \\) word+="${line:i:1}"; i=$((i + 1)); inword=1 ;;
    "'"|'"') quote="$c"; inword=1 ;;
    *) word+="$c"; inword=1 ;;
  esac
done
[ -z "$quote" ] || { echo "fake adb: unterminated quote: $line" >&2; exit 96; }
[ "$inword" -eq 0 ] || words+=("$word")
set -- ${words[@]+"${words[@]}"}
case "$1 ${2:-}" in
  "getprop ro.product.model") cat "$dev/model" 2>/dev/null ;;
  "getprop ro.serialno") cat "$dev/serialno" 2>/dev/null ;;
  "dumpsys power") cat "$dev/power" ;;
  "dumpsys window")
    case "${3:-}" in
      "") cat "$dev/window.lastanr" 2>/dev/null; cat "$dev/window.policy" "$dev/window.displays" ;;
      policy|displays) cat "$dev/window.$3" ;;
      *) echo "fake adb: unknown: $*" >&2; exit 97 ;;
    esac ;;
  "dumpsys activity") [ "${3:-}" = activities ] || { echo "fake adb: unknown: $*" >&2; exit 97; }; cat "$dev/activity" ;;
  "input keyevent")
    if [ "${3:-}" = KEYCODE_WAKEUP ] && [ -f "$dev/wake.wakes" ]; then
      sed -i.bak 's/mWakefulness=[A-Za-z]*/mWakefulness=Awake/' "$dev/power"
    fi ;;
  "input "*) ;;
  "wm size") cat "$dev/wm.size" 2>/dev/null || echo "Physical size: 1080x1240" ;;
  "wm density") cat "$dev/wm.density" 2>/dev/null || echo "Physical density: 480" ;;
  "wm dismiss-keyguard")
    if [ -f "$dev/wake.unlocks" ]; then
      sed -i.bak 's/isKeyguardShowing=true/isKeyguardShowing=false/' "$dev/window.displays"
      sed -i.bak 's/mKeyguardShowing=true/mKeyguardShowing=false/' "$dev/activity"
    fi ;;
  "am start") [ -f "$dev/window.displays.launched" ] && cp "$dev/window.displays.launched" "$dev/window.displays"; echo "Status: ok" ;;
  "am force-stop") ;;
  "settings get") cat "$dev/settings/$3.$4" 2>/dev/null || echo null ;;
  "settings put") mkdir -p "$dev/settings"; printf '%s\n' "$5" > "$dev/settings/$3.$4" ;;
  "settings delete") rm -f "$dev/settings/$3.$4"; echo "Deleted 1 rows" ;;
  *) echo "fake adb: unknown shell command: $*" >&2; exit 97 ;;
esac
